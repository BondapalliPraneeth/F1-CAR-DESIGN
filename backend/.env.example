# Copy to backend/.env for local development. Never commit the real .env.

ENVIRONMENT=development

# Leave unset to use a local SQLite file (./apexvision.db).
# Neon: use the POOLED string (host contains "-pooler") for the app,
# e.g. postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Optional Neon DIRECT (non-pooled) string; used only by Alembic migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# AI assistant: auto | gemini | openai | neon | offline
# "auto" uses Gemini if GEMINI_API_KEY is set, else OpenAI, else the Neon AI Gateway, else the offline rule-based engine.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Groq (free tier at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Neon AI Gateway (written to .env.local by `neon deploy`). Needs prepaid AI credits on the Neon account;
# without credits it returns 403 and the app falls back to the offline engine.
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_AI_MODEL=claude-haiku-4-5
AI_RATE_LIMIT_PER_MINUTE=12
# Cap on assistant questions per minute across all visitors (bounds LLM spend).
AI_GLOBAL_RATE_LIMIT_PER_MINUTE=60
