# Copy to backend/.env for local development. Never commit the real .env.

ENVIRONMENT=development

# Leave unset to use a local SQLite file (./apexvision.db).
# Neon example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# AI assistant: auto | gemini | openai | offline
# "auto" uses Gemini if GEMINI_API_KEY is set, else OpenAI, else the offline rule-based engine.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=12
